# Core Flask settings
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0
PORT=5000

# Initial authority account (used only when a brand-new database is created)
CIVICOS_ADMIN_USERNAME=admin
CIVICOS_ADMIN_PASSWORD=replace-this-password

# Optional AI-assisted routing; local routing works without this
OPENAI_API_KEY=
CIVICOS_AI_MODEL=gpt-4.1-mini

# Optional citizen email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1

# Hackathon/demo mode: lets field-team dashboards operate without an admin login.
# Set to 0 when you add real worker authentication for production.
CIVICOS_DEMO_WORKER_ACCESS=1

# Citizen SMS notifications
FAST2SMS_API_KEY=
# Public HTTPS URL used in SMS links, e.g. https://civicos.example.com
CIVICOS_PUBLIC_BASE_URL=
