# Core Flask settings
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0
PORT=5000

# Initial authority account (used only when a brand-new database is created)
CIVICOS_ADMIN_USERNAME=admin
CIVICOS_ADMIN_PASSWORD=replace-this-password

# Optional AI-assisted routing; local routing works without this
OPENAI_API_KEY=
CIVICOS_AI_MODEL=gpt-4.1-mini

# Optional citizen email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1

# Worker authentication is mandatory. Field teams use the separate Worker Login.
# This initial password is used only when worker accounts are first seeded.
CIVICOS_WORKER_DEFAULT_PASSWORD=worker123

# Set to 1 only when the site is served over HTTPS.
CIVICOS_SECURE_COOKIES=0

# Public URL used inside email action links. Set this to your deployed HTTPS domain.
# Example: https://civicos.example.com
CIVICOS_PUBLIC_URL=

# Citizen verification uses a 6-digit email OTP through SMTP.
# No Google Cloud OAuth credentials are required in this build.

# SMTP_SECURITY can be: starttls (usually port 587), ssl (usually port 465), or none.
# For Gmail use an App Password, not your normal Google password.
SMTP_SECURITY=starttls

# Local alternative: Command Center -> Settings -> Email & OTP Setup can save
# these integrations to instance/integrations.json. Environment variables above
# take precedence and are recommended for Render/production.
